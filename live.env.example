# Copy to live.env and chmod 600 live.env. Never commit real credentials.
PHEMEX_API_KEY=your-live-key
PHEMEX_API_SECRET=your-live-secret
# Live connectivity also requires --live and interactive LIVE confirmation.
# This increment permits read-only access and previews; all mutations are blocked.
PHEMEX_ALLOW_LIVE=false
MAX_NOTIONAL_USDT=200
MAX_LEVERAGE=5
